        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 9,
      "title": "Активные сессии",
      "type": "timeseries",
      "description": "Число сессий в памяти процесса. Не равно количеству пользователей онлайн.",
